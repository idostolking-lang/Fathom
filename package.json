{
  "name": "fathom",
  "version": "1.0.0",
  "description": "Local lead-intelligence and market-research console. Compose Discover, Filter, Enrich, Analyze, Send, and Save into reusable Routines, run them on demand or on a cron schedule, and persist everything in local SQLite. Node/Express, Puppeteer/Playwright, OpenAI GPT-4o, and WhatsApp.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test"
  },
  "keywords": [
    "lead-intelligence",
    "market-research",
    "lead-generation",
    "lead-enrichment",
    "routines",
    "pipeline",
    "workflow-engine",
    "cron",
    "scheduler",
    "google-maps",
    "puppeteer",
    "playwright",
    "openai",
    "gpt-4o",
    "sqlite",
    "better-sqlite3",
    "express",
    "whatsapp",
    "email-outreach",
    "background-tasks"
  ],
  "files": [
    ".env.example",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "SETUP.md",
    "docs/guides/",
    "lib/",
    "public/",
    "server.js",
    "src/",
    "test/"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "nodemailer": "^8.0.10",
    "openai": "^4.20.1",
    "playwright": "^1.60.0",
    "puppeteer": "^25.1.0",
    "qrcode": "^1.5.3",
    "whatsapp-web.js": "^1.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}

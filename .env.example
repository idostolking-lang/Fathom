# OpenAI API Configuration
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o

# Email Configuration (Gmail app password recommended)
EMAIL_USER=your-email@example.com
EMAIL_PASS=replace-with-your-gmail-app-password
EMAIL_FROM_NAME=Lead Sender

# Optional Instagram automation. Disabled by default because it requires a
# manually installed unofficial dependency and carries account risk.
ENABLE_INSTAGRAM_AUTOMATION=false

# Optional SMS via a pluggable HTTP gateway (self-hosted Android gateway, or any HTTP SMS provider).
# The SMS step/channel POSTs JSON { phone, message } (field names configurable) to this URL.
SMS_GATEWAY_URL=
SMS_GATEWAY_METHOD=POST
SMS_GATEWAY_AUTH=
SMS_GATEWAY_TO_FIELD=phone
SMS_GATEWAY_TEXT_FIELD=message

# Server Configuration
PORT=7000
HOST=0.0.0.0
NODE_ENV=development

# Session Configuration
SESSION_SECRET=replace-with-a-long-random-string

# Dashboard/API access token. Required when HOST is 0.0.0.0.
APP_ACCESS_TOKEN=replace-with-a-long-random-dashboard-token

# Optional comma-separated CORS origins beyond localhost/private/Tailscale origins.
ALLOWED_ORIGINS=
